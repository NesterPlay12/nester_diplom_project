modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"
run = ["bash", "flask-app/start.sh"]

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[nix]
channel = "stable-25_05"
packages = ["cargo", "libiconv", "libxcrypt", "openssl", "pkg-config", "rustc", "unrar"]

[userenv]

[userenv.shared]
FLASK_DATABASE_SCHEMA = "wildmarket"
FLASK_DATABASE_SOURCE = "replit"

[userenv.production]
GOOGLE_OAUTH_ENABLED = "true"
